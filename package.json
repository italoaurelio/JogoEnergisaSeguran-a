{
  "name": "jogo-seguranca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "checar": "tsc --noEmit",
    "arte": "./publicar-arte.sh",
    "electron:dev": "node electron/dev.mjs",
    "electron": "npm run build && electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win:instalador": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "paisagem": "PAISAGEM_TESTE=1 node --experimental-strip-types src/cena/paisagem.ts",
    "gabarito": "GABARITO_TESTE=1 node --experimental-strip-types src/conteudo/gabarito.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "3.0.4",
    "n8ao": "1.9.4",
    "postprocessing": "6.37.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.3.0": true
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.energisa.olhonorisco",
    "productName": "Olho no Risco",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "empacotado"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
